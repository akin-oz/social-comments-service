    {
      "name": "2 · Retrieve comments",
      "item": [
        {
          "name": "List comments — tenant A (RUN FIRST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"shape is data/pagination/snapshot\", () => pm.expect(b).to.have.all.keys(\"data\",\"pagination\",\"snapshot\"));",
                  "pm.test(\"pagination has hasMore + nextCursor\", () => pm.expect(b.pagination).to.have.all.keys(\"hasMore\",\"nextCursor\"));",
                  "// Capture a top-level comment id so the reply requests can chain off it.",
                  "const top = (b.data || []).find((c) => c.parentCommentId === null);",
                  "if (top) { pm.collectionVariables.set(\"commentId\", top.id); console.log(\"captured commentId =\", top.id); }",
                  "else { console.warn(\"no top-level comment found on this post\"); }",
                  "if (b.pagination && b.pagination.nextCursor) pm.collectionVariables.set(\"cursor\", b.pagination.nextCursor);",
                  "// Provider identifiers must never leak.",
                  "pm.test(\"no provider comment/post id fields leak\", () => { const c = (b.data||[])[0]; if (c) pm.expect(c).to.have.all.keys(\"id\",\"postId\",\"platform\",\"author\",\"body\",\"parentCommentId\",\"publishedAt\",\"updatedAt\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Account-Id",
                "value": "{{accountA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/posts/{{postA}}/comments?limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "posts",
                "{{postA}}",
                "comments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            },
            "description": "QA-08/09/11 — happy path. Populates {{commentId}} and {{cursor}} for later requests. Run this before the Reply folder."
          }
        },
        {
          "name": "List comments — next page (uses {{cursor}})",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"cursor\")) console.warn(\"Run \\\"List comments — tenant A\\\" first, and only if hasMore was true.\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns a page\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Account-Id",
                "value": "{{accountA}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/posts/{{postA}}/comments?limit=1&cursor={{cursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "posts",
                "{{postA}}",
                "comments"
