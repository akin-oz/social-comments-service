    {
      "name": "4 · Reply (publishes data — run List first)",
      "item": [
        {
          "name": "Reply to a top-level comment (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"commentId\")) console.warn(\"Run \\\"List comments — tenant A\\\" first to capture {{commentId}}.\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"parentCommentId matches the target\", () => pm.expect(d.parentCommentId).to.eql(pm.collectionVariables.get(\"commentId\")));",
                  "pm.test(\"body is echoed\", () => pm.expect(d.body).to.eql(\"Thank you!\"));",
                  "pm.test(\"id is a new service uuid\", () => pm.expect(d.id).to.match(/^[0-9a-f-]{36}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Account-Id",
                "value": "{{accountA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v2/comments/{{commentId}}/replies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "comments",
                "{{commentId}}",
                "replies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"body\":\"Thank you!\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "QA-22 — fresh Idempotency-Key each send via {{$guid}}."
          }
        },
