          "name": "Idempotent replay — first send",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemKeyReplay\", \"pm-replay-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
